# syntax=docker/dockerfile:1

# ─── builder ──────────────────────────────────────────────────────────────────
FROM node:24 AS builder

WORKDIR /app

# pnpm is the only package manager this repo accepts (see `preinstall`).
RUN npm install -g pnpm@11.16.0

# Manifests first: a source edit then reuses the cached install layer instead of
# re-resolving 1.5k packages. `pnpm-workspace.yaml` carries the `overrides` and
# the `patchedDependencies`, so it (and patches/) must come along or
# --frozen-lockfile refuses to install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ ./patches/
RUN pnpm install --frozen-lockfile

# Branding. These are compile-time (Vite inlines import.meta.env.VITE_*), so the
# image is Teleram-branded; .env itself is never copied into the image.
ARG VITE_RSA_MODULUS
ARG VITE_RSA_TEST_MODULUS
ARG VITE_BASE_DC_ID
ARG VITE_DC_HOST
ARG VITE_DC_PORT
ARG VITE_ALLOWED_HOSTS
ARG VITE_APP_NAME
ARG VITE_APP_PROTOCOL
ARG VITE_SHORT_DOMAIN

ENV VITE_RSA_MODULUS=$VITE_RSA_MODULUS \
    VITE_RSA_TEST_MODULUS=$VITE_RSA_TEST_MODULUS \
    VITE_BASE_DC_ID=$VITE_BASE_DC_ID \
    VITE_DC_HOST=$VITE_DC_HOST \
    VITE_DC_PORT=$VITE_DC_PORT \
    VITE_ALLOWED_HOSTS=$VITE_ALLOWED_HOSTS \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_APP_PROTOCOL=$VITE_APP_PROTOCOL \
    VITE_SHORT_DOMAIN=$VITE_SHORT_DOMAIN

COPY . .

# The deployment config, for the builder only. Vite's loadEnv fills every
# VITE_* from it — the transport switches (VITE_MTPROTO_*), the API
# credentials and the version numbers are NOT build ARGs, and without them the
# client cannot build a single transport. The runtime stage copies dist/ and
# not the context, so this file never leaves the builder.
COPY .env ./.env

# Build the bundle.
#
# `node build` is NOT used: it runs the whole vitest suite and fetches the lang
# pack from translations.telegram.org, neither of which belongs in an image
# build. Tests run in CI. `apply-new-lang` is skipped deliberately — the host
# may not reach the translations server, and the repo already ships a lang pack.
#
# Note the bundle is always produced here, never inherited from the context: a
# skipped or failed step must fail the image build, not quietly ship whatever
# happened to be in public/.
RUN pnpm run format-lang \
 && npx vite build \
 && node scripts/check-bundle-mangling.mjs dist


# ─── runtime ─────────────────────────────────────────────────────────────────
FROM nginx:stable-alpine3.20-slim AS runtime

RUN apk update && apk upgrade --no-cache

# The bundle plus the static content beside it. `vite build` writes only JS/CSS
# (copyPublicDir is false), so assets/ and changelogs/ come from the repo.
COPY --from=builder /app/dist/            /usr/share/nginx/html/
COPY --from=builder /app/public/assets/   /usr/share/nginx/html/assets/
COPY --from=builder /app/public/changelogs/ /usr/share/nginx/html/changelogs/
COPY .docker/nginx.conf                   /etc/nginx/conf.d/default.conf

# nginx's master process still runs as root so it can bind :80; the workers are
# what serve requests.
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1