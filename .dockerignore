# Build context: keep it small, and keep deployment config out of the daemon.
#
# The builder needs sources, manifests, and the static content in public/:
#   public/assets    36 MB of fonts/tgs/audio/img, served by nginx
#   public/changelogs fetched at runtime by apiUpdatesManager
# Everything else is huge, machine-local, or a credential.

# Dependencies — reinstalled in the builder from the lockfile.
node_modules
.pnpm-store

# Build output. The image builds its own bundle; carrying the committed one in
# would let a stale bundle reach an image if the build step ever got skipped.
dist

# ...and the bundle committed under public/ is the same thing. Only the static
# content beside it is an input to the image.
public/*
!public/assets
!public/assets/**
!public/changelogs
!public/changelogs/**

# The deployment config is local (copy .env.example), and every value in it
# reaches the builder as a build ARG, so the file itself never enters the build
# context.
.env

# VCS, CI and agent tooling state.
.git
.github
.claude
.agents
.idea
tmp
archive.zip
stats.html
*.log